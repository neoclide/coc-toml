{
  "compilerOptions": {
    "target": "es2019",
    "lib": [
      "ES2019"
    ],
    "sourceMap": false,
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src"
  ]
}
